class MyRegex {
    // 0-199: [01]?\\d{1,2}
    // 200-249: 2[0-4]\\d
    // 250-255: 25[0-5]
    // A single block (A, B, C, or D) can be represented by: ([01]?\\d{1,2}|2[0-4]\\d|25[0-5])
    
    String pattern = "^([01]?\\d{1,2}|2[0-4]\\d|25[0-5])\\.([01]?\\d{1,2}|2[0-4]\\d|25[0-5])\\.([01]?\\d{1,2}|2[0-4]\\d|25[0-5])\\.([01]?\\d{1,2}|2[0-4]\\d|25[0-5])$";
}
