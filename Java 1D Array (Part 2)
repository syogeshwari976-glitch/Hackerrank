import java.util.*;

public class Solution {

    public static boolean canWin(int leap, int[] game) {
        return checkPath(leap, game, 0);
        // Return true if you can win the game; otherwise, return false.
    }
    public static boolean checkPath(int leap, int[] game, int pos) {
        int n = game.length;
        if(pos>=n-1 || pos+leap>=n) return true;
        game[pos] = 1;
        
        boolean first = false;
        boolean second = false;
        boolean third = false;
            
        if(pos>0 && game[pos-1]==0){
            first = checkPath(leap, Arrays.copyOf(game, game.length), pos-1);
        }
        if (game[pos+1]==0) {
            second = checkPath(leap, Arrays.copyOf(game, game.length), pos+1);
        }
        if (game[pos+leap]==0) {
            third = checkPath(leap, Arrays.copyOf(game, game.length), pos+leap);
        }
        
        return first || second || third;
        
    }

    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        int q = scan.nextInt();
        while (q-- > 0) {
            int n = scan.nextInt();
            int leap = scan.nextInt();
            
            int[] game = new int[n];
            for (int i = 0; i < n; i++) {
                game[i] = scan.nextInt();
            }

            System.out.println( (canWin(leap, game)) ? "YES" : "NO" );
        }
        scan.close();
    }
}
